# Mots-clés de recherche (ancienne variable simple)
QUERY=one piece tome
# Pour plusieurs recherches simultanées (séparateur: virgule ou point-virgule)
# Exemple : QUERIES=one piece;bleach, naruto
# Si QUERIES est défini, QUERY est ignoré.
#QUERIES=one piece;bleach
# Intervalle de polling en secondes (évitez <30 pour ne pas spammer)
POLL_INTERVAL=90
# Filtrage prix optionnel
#MIN_PRICE=1
#MAX_PRICE=20
# Webhook Discord optionnel
#DISCORD_WEBHOOK=https://discord.com/api/webhooks/xxxxx/xxxxx
# Notification par e-mail optionnelle (toutes les variables sont requises pour l'activer)
# Exemple avec Gmail : hôte smtp.gmail.com, port 587, utiliser un mot de passe d'application
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=votre.adresse@gmail.com
#SMTP_PASSWORD=mot-de-passe-application
#EMAIL_FROM=votre.adresse@gmail.com
#EMAIL_TO=destinataire@example.com
# Exécution unique pour test
#RUN_ONCE=1
# Fichier persistance IDs
#SEEN_FILE=data/seen_ids.json
# Regex inclusion (ex: uniquement tomes 1 à 5)
#INCLUDE_REGEX=\b(tome\s*(1|2|3|4|5))\b
# Regex exclusion (ex: exclure scans ou lot)
#EXCLUDE_REGEX=scan|lot
# Nombre de pages à parcourir
#MAX_PAGES=2
# Fichier logs
#LOG_FILE=bot.log
# Mode debug (logs verbeux)
#DEBUG=1
